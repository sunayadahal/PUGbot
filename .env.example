# PUGbot configuration.
#
# Debug and production read entirely separate variables. There is no shared
# fallback: if a debug variable is missing, startup fails rather than reaching
# for the production one. Copy this file to `.env.debug` / `.env.production`
# and pass it with `--env-file`, or export the variables directly.
#
# Never commit a filled-in copy of this file.

# ---------------------------------------------------------------- debug mode
# Start with: pugbot --mode debug --env-file .env.debug

# A dedicated test bot application — not the production one.
PUGBOT_DEBUG_DISCORD_TOKEN=
PUGBOT_DEBUG_APPLICATION_ID=

# A dedicated database or schema. Startup refuses to run if this matches the
# production URL.
PUGBOT_DEBUG_DATABASE_URL=postgres://pugbot:password@localhost:5432/pugbot_debug
PUGBOT_DEBUG_DATABASE_MAX_CONNECTIONS=5

# Required in debug mode. Interactions from any other guild are rejected, and
# commands are registered per guild so edits appear instantly. A guild listed
# here must not also appear in the production allowlist.
PUGBOT_DEBUG_GUILD_ALLOWLIST=000000000000000000

# Comma-separated user IDs with owner-level access.
PUGBOT_DEBUG_OWNER_IDS=

# Defaults to pugbot=debug,info in debug mode.
PUGBOT_DEBUG_LOG_LEVEL=pugbot=debug,info

# Optional health, readiness, and metrics endpoint.
PUGBOT_DEBUG_HEALTH_BIND=127.0.0.1:8081

# ----------------------------------------------------------- production mode
# Start with: pugbot --mode production --env-file .env.production

PUGBOT_PRODUCTION_DISCORD_TOKEN=
PUGBOT_PRODUCTION_APPLICATION_ID=

PUGBOT_PRODUCTION_DATABASE_URL=postgres://pugbot:password@db.internal:5432/pugbot
PUGBOT_PRODUCTION_DATABASE_MAX_CONNECTIONS=20

# Optional in production. Empty means "serve any guild the bot is invited to";
# set it to restrict the bot to approved servers.
PUGBOT_PRODUCTION_GUILD_ALLOWLIST=

PUGBOT_PRODUCTION_OWNER_IDS=
PUGBOT_PRODUCTION_LOG_LEVEL=pugbot=info,warn
PUGBOT_PRODUCTION_HEALTH_BIND=0.0.0.0:8080
PUGBOT_PRODUCTION_PUBLIC_URL=

# -------------------------------------------------------------------- tests
# Set this to run the database integration tests. Each test creates and drops
# its own schema, so point it at a throwaway database.
# PUGBOT_TEST_DATABASE_URL=postgres://pugbot:password@localhost:5432/pugbot_test
